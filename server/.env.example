PORT=3000                     # порт для бэкенда
API_TIMEOUT_MS=1000           # таймаут сетевых запросов к внешним API (мс)

BACKUP_API_KEY=""

FRONTEND_URL=http://localhost:5173

# AI Configuration (Local LLM)
LLM_BASE_URL=http://llama-server:8080/v1
LLM_API_KEY=not-needed
LLM_MODEL=gemma-4-E2B-it-Q4_K_M
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.8
LLM_TOP_P=0.9
LLM_REPEAT_PENALTY=1.08
LLM_FREQUENCY_PENALTY=0.15
LLM_PRESENCE_PENALTY=0.15
LLM_TIMEOUT_MS=75000
LLM_MAX_HISTORY=5
LLM_MAX_CHAR_LIMIT=1000

# System 1 Decision Model (Jev-Style)
JEV_BASE_URL=http://localhost:8001
JEV_TIMEOUT_MS=3500
